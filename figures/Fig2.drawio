        <!-- Box 2B: Standardization & Precomputed Gram Matrix -->
        <mxCell id="c2_b2" value="&lt;b&gt;Gram Matrix Precomputation &amp; Covariance Structure&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 9px;&quot;&gt;Predictor standardization (zero mean, unit variance)&lt;br&gt;Exact precomputed Gram matrix &lt;b&gt;G&lt;/b&gt; = &lt;b&gt;X&lt;/b&gt;ᵀ&lt;b&gt;X&lt;/b&gt; ∈ ℝ⁹ˣ⁹ and &lt;b&gt;X&lt;/b&gt;ᵀ&lt;b&gt;y&lt;/b&gt; ∈ ℝ⁹&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b7bb9;strokeWidth=1.1;arcSize=3;fontSize=10.5;fontColor=#0f172a;fontFamily=Helvetica;" vertex="1" parent="1">
